# Пример /etc/llm-gateway.env. Реальный файл создаёт deploy.sh при первой
# установке (генерирует GW_API_TOKEN и SESSION_SECRET) и больше не перезаписывает.
#
# Здесь ТОЛЬКО bootstrap. Ключ DeepSeek, тарифы, персона и политика гарда
# задаются из админки (/gw/admin) и лежат в SQLite — в этом файле их нет.

# Admin bearer-токен: админка /gw/admin, curl. openssl rand -hex 32
GW_API_TOKEN=замени-на-случайный-токен
# Резервный секрет подписи (на будущее). openssl rand -hex 32
SESSION_SECRET=замени-на-случайный-секрет

GW_HOST=127.0.0.1
GW_PORT=3400
GW_DB_PATH=/opt/llm-gateway/data/gateway.db

LOG_LEVEL=info
