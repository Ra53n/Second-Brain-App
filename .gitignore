icon/*.iconset/
icon/icon_1024.png

# macOS
.DS_Store

# Секреты и локальные файлы — никогда не коммитим
*.key
*.local.*
.env

# Смоук-отчёты (задача 60) — генерируются, не коммитим
smoke/out/

# finetune: окружение и веса. data/ и baseline/ коммитим — это и есть
# зафиксированная точка отсчёта, пересборка дала бы уже другие числа.
finetune/.venv/
finetune/__pycache__/
finetune/adapters/
finetune/runs/
finetune/tuned/
finetune/dictation/adapters/
finetune/dictation/runs/
finetune/dictation/tuned/
finetune/meetings/adapters/
finetune/meetings/runs/
finetune/meetings/tuned/
# Исходный корпус AMI (23 МБ архива + XML) и кеш перевода: и то, и другое
# восстанавливается скриптами, в репозитории только собранный датасет.
finetune/meetings/source/
finetune/meetings/data/translations.json
finetune/meetings/translate.log
