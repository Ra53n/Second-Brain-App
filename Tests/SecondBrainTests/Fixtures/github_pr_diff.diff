diff --git a/Sources/App/StreamParser.swift b/Sources/App/StreamParser.swift
index 1111111..2222222 100644
--- a/Sources/App/StreamParser.swift
+++ b/Sources/App/StreamParser.swift
@@ -10,6 +10,9 @@ struct StreamParser {
     func parse(_ chunk: String) -> [Event] {
+        // Пустой чанк — конец keep-alive, не событие.
+        guard !chunk.isEmpty else { return [] }
         var events: [Event] = []
         for line in chunk.split(separator: "\n") {
             events.append(Event(line: String(line)))
         }
         return events
     }
