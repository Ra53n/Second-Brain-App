# Bootstrap-конфигурация саппорт-ассистента. На VPS лежит в
# /etc/support-assistant.env (НЕ в git, режим 0640, владелец root:supportassistant).
#
# Здесь — ТОЛЬКО bootstrap. LLM-провайдер/ключ/модели задаются ИЗ АДМИНКИ
# (вкладка «Настройки») и хранятся в БД, а не здесь.

# Admin bearer-токен (полный доступ к API из скриптов/curl в обход веб-сессий).
# Сгенерируй свой: openssl rand -hex 32. deploy.sh создаёт автоматически.
SUPPORT_API_TOKEN=replace-with-strong-random-token

# Секрет подписи cookie веб-сессий (вход в веб-интерфейс /support/).
SESSION_SECRET=replace-with-strong-random-secret

# HTTP-сервер. Наружу не открывается — только loopback за Caddy.
SUPPORT_HOST=127.0.0.1
SUPPORT_PORT=3200

# SQLite с пользователями/чатами/настройками/индексом KB. Переживает деплой.
SUPPORT_DB_PATH=/opt/support-assistant/data/support.db

# База знаний (markdown) и CRM-данные (users.json/tickets.json).
SUPPORT_KB_DIR=/opt/support-assistant/data/kb
SUPPORT_CRM_DIR=/opt/support-assistant/data/crm

# Адрес локальной Ollama (loopback, без Caddy/токена).
OLLAMA_URL=http://127.0.0.1:11434

LOG_LEVEL=info
