{
  "name": "agent-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Агент-мишень для red-team проверки: чат с инструментами (веб-поиск, загрузка страниц, подсадная внутренняя база), защитными слоями против prompt-инъекций и журналом попыток взлома. Данные внутри лаборатории выдуманные.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --import tsx/esm src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "attack-smoke": "node test/attack-smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "better-sqlite3": "^11.8.0",
    "fastify": "^4.28.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
