# Пример /etc/agent-lab.env. Реальный файл создаёт deploy.sh при первой
# установке (генерирует LAB_API_TOKEN и SESSION_SECRET) и больше не перезаписывает.
#
# Здесь ТОЛЬКО bootstrap. Ключ LLM, ключ веб-поиска и уровень защиты задаются
# из админки и лежат в SQLite — в этом файле их нет.

# Admin bearer-токен: админка, curl, атака-смоук. openssl rand -hex 32
LAB_API_TOKEN=замени-на-случайный-токен
# Секрет подписи cookie сессий. openssl rand -hex 32
SESSION_SECRET=замени-на-случайный-секрет

LAB_HOST=127.0.0.1
LAB_PORT=3300
LAB_DB_PATH=/opt/agent-lab/data/lab.db
LAB_CORP_DIR=/opt/agent-lab/data/corp

# Первичный код доступа для атакующих. Используется ТОЛЬКО если код ещё не
# задан в БД; дальше меняется из админки и этот параметр не перечитывается.
LAB_ACCESS_CODE=

LOG_LEVEL=info
