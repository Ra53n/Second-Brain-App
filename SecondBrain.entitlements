<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SecondBrain.entitlements — права приложения при подписи с hardened runtime
     (задача 18). Hardened runtime без явного audio-input блокирует микрофон.
     Sandbox НЕ включаем: приложение работает с произвольной папкой vault,
     запускает дочерние процессы (Ollama, MCP-серверы) и git.

     com.apple.security.cs.disable-library-validation оставлено выключенным:
     свои дилибы не грузим. Если после подписи перестанут запускаться
     дочерние рантаймы с неподписанными плагинами — включить его осознанно. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
