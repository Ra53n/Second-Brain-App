# Пример /etc/llm-harness.env. deploy.sh создаёт реальный файл при первой
# установке, генерируя HARNESS_API_TOKEN и HARNESS_CANARY. Секреты не в git.

HARNESS_API_TOKEN=<генерируется deploy.sh>
HARNESS_HOST=127.0.0.1
HARNESS_PORT=3500
HARNESS_DB_PATH=/opt/llm-harness/data/harness.db
# Gateway на том же VPS (localhost). Весь LLM-трафик идёт сюда.
GW_URL=http://127.0.0.1:3400/gw
# Секретная фраза-канарейка: если всплывёт в ответе модели — промпт пробит.
HARNESS_CANARY=<генерируется deploy.sh>
LOG_LEVEL=info
